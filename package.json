{
  "name": "sourcedesk-ai",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "SourceDesk AI: offline cited answers with replaceable subject packs and shared local models",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wongcyrus/sourcedesk-ai.git"
  },
  "scripts": {
    "build": "node scripts/build-browser.mjs",
    "build:subject": "node scripts/build-subject.mjs",
    "test": "node --experimental-vm-modules --test",
    "test:retrieval": "node scripts/evaluate-subject.mjs",
    "prepare:python-source": "python3 examples/python/prepare_source.py",
    "prepare:offline": "node scripts/prepare-offline.mjs",
    "prepare:models": "node scripts/prepare-models.mjs",
    "activate:subject": "python3 windows/activate-subject.py",
    "start": "http-server offline -a 127.0.0.1 -p 8080 -c-1 -o /",
    "demo": "npm start --",
    "package:windows": "python3 scripts/package-windows.py",
    "package:subject": "python3 scripts/package-windows.py --subject",
    "test:windows": "python3 -m unittest discover -s test -p '*_test.py'"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.2",
    "@litert-lm/core": "0.15.0",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "esbuild": "^0.25.0",
    "http-server": "^14.1.1",
    "linkedom": "^0.18.12",
    "mammoth": "^1.13.0",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "^6.5.438"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "sharp": "^0.35.5"
  }
}
